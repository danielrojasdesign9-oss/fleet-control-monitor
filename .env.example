# Base de la API de Traccar.
# Por defecto se usa un proxy same-origin (/traccar → https://simulator.traccar.org/api)
# para evitar problemas de CORS con el simulador oficial (solo lectura, datos en vivo).
VITE_TRACCAR_URL=/traccar

# Destino del proxy en desarrollo (Vite) y rewrites (Vercel).
VITE_TRACCAR_PROXY_TARGET=https://simulator.traccar.org
