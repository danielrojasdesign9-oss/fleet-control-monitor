{
  "rewrites": [
    {
      "source": "/traccar/:path*",
      "destination": "https://simulator.traccar.org/api/:path*"
    },
    {
      "source": "/demo4/:path*",
      "destination": "https://demo4.traccar.org/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
